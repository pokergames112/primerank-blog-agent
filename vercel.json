{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/dashboard/(.*)", "destination": "/public/dashboard/" },
    { "source": "/(.*)", "destination": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/generate",
      "schedule": "0 8 * * *"
    }
  ]
}
