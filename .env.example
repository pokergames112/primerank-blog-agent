# ==========================================
# Configurações do Agente Prime Rank Marketing
# ==========================================

# Porta do Servidor e Dashboard Web
PORT=3000
HOST=http://localhost:3000

# Chave da API de IA (OpenAI ou Gemini ou compatível)
# Para OpenAI (GPT-4o / GPT-4o-mini):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Provedor alternativo Gemini (se desejar usar Google Gemini):
GEMINI_API_KEY=

# Bot do Telegram para Validação no Celular (Opcional, mas altamente recomendado)
# Crie seu bot no Telegram falando com o @BotFather e cole o token abaixo
TELEGRAM_BOT_TOKEN=
# Seu ID de chat no Telegram (para receber notificações automáticas de aprovação)
TELEGRAM_ADMIN_CHAT_ID=

# Configuração de Postagem Automática / Webhooks do Blog
# URL do webhook ou endpoint externo caso o site já tenha um backend
BLOG_WEBHOOK_URL=
BLOG_WEBHOOK_SECRET=

# Frequência de Execução Automática (Cron)
# Padrão: Todos os dias às 08:00 da manhã ('0 8 * * *')
CRON_SCHEDULE="0 8 * * *"
AUTO_DISCOVER_TRENDS=true
